{
  "name": "@turkraft/filterkit",
  "version": "1.0.0",
  "description": "Filter expression language — parse, build, and transform filter queries. Syntax-compatible with Spring Filter (Java).",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/turkraft/filterkit.git"
  },
  "author": "Yusuf Torshid",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/turkraft/filterkit/issues"
  },
  "homepage": "https://github.com/turkraft/filterkit#readme",
  "keywords": [
    "filter",
    "expression",
    "parser",
    "query",
    "filtering",
    "dsl",
    "typescript"
  ],
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/torshid"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^3.1.0"
  },
  "sideEffects": false
}
